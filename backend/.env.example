# ============================================================
# FRANCE UNSC CRISIS COMMAND — Environment Configuration
# ============================================================

# Project
PROJECT_NAME="FRANCE UNSC CRISIS COMMAND"
API_V1_STR="/api/v1"

# Security (change this in production!)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL="sqlite:///./france_unsc_crisis.db"

# ─── AI Configuration ─────────────────────────────────────
# AI Modes: LOCAL | CLOUD | HYBRID
AI_MODE="HYBRID"

# Gemini (Primary Provider)
GEMINI_API_KEY="YOUR_GOOGLE_API_KEY_HERE"

# Agent Assignment (gemini | claude | openai | local)
AGENT_RESEARCH_PROVIDER="gemini"
AGENT_RESEARCH_MODEL="gemini-3.8-flash"

AGENT_COUNTRY_PROVIDER="gemini"
AGENT_COUNTRY_MODEL="gemini-3.5-flash-lite"

AGENT_COACH_PROVIDER="gemini"
AGENT_COACH_MODEL="gemini-3.8-flash"

AGENT_ORCHESTRATOR_PROVIDER="gemini"
AGENT_ORCHESTRATOR_MODEL="gemini-3.8-flash"

# Optional: Claude / OpenAI (leave blank if not using)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Local AI (Ollama) — leave default if not using local models
LOCAL_AI_BASE_URL="http://localhost:11434"
LOCAL_AI_MODEL="llama3"
